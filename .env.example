# NVIDIA_API_KEY: clave para el cerebro de SIFER (planificador, chat y transcripcion de voz).
# En AI Studio se inyecta automaticamente desde el panel de Secrets.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# NVIDIA_MODEL: modelo OpenAI-compatible de NVIDIA para razonamiento (plan/chat).
NVIDIA_MODEL="z-ai/glm-5.3-flash"

# NVIDIA_TRANSCRIBE_MODEL: modelo de voz para transcribir audio (modo transcribe).
NVIDIA_TRANSCRIBE_MODEL="openai/whisper-large-v3"

# NVIDIA_BASE_URL: endpoint compatible con OpenAI de NVIDIA.
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN: base de datos remota del POS
# (ventas, inventario, pedidos, memoria y atlas de SIFER).
TURSO_DATABASE_URL="libsql://..."
TURSO_AUTH_TOKEN="MY_TURSO_AUTH_TOKEN"

# Proveedores IA opcionales gratuitos (se usan antes que NVIDIA si estan definidos).
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="qwen3:8b"
# DEEPSEEK_API_KEY=""
# AI_COMPATIBLE_BASE_URL=""
# AI_COMPATIBLE_MODEL="qwen3:8b"
# AI_COMPATIBLE_API_KEY=""

# APP_URL: URL donde esta alojada la app (AI Studio la inyecta en runtime).
APP_URL="MY_APP_URL"
